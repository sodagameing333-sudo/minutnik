<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="520"
        Width="400" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        x:Class="minutnik.MainWindow"
        Title="Minutnik">

    <Border Padding="25" Background="{DynamicResource SystemRegionBrush}">
        <StackPanel Spacing="15" VerticalAlignment="Center">
            <!-- Nagłówek stanu: Praca / Przerwa -->
            <TextBlock x:Name="StatusText"
                       Text="Tryb: Praca"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#1E88E5" />

            <!-- Wyświetlacz odliczanego czasu (mm:ss) -->
            <Border Background="{DynamicResource SystemAltHighColor}"
                    CornerRadius="12"
                    Padding="20,10"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="TimerText"
                           Text="25:00"
                           FontSize="64"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           LetterSpacing="2" />
            </Border>

            <!-- Licznik ukończonych cykli -->
            <TextBlock x:Name="CyclesText"
                       Text="Ukończone cykle: 0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemBaseHighColor}" />

            <!-- Pola modyfikacji czasu pracy i przerwy -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15,10"
                    Margin="0,5">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Czas pracy (min):"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   x:Name="WorkTimeInput"
                                   Minimum="1"
                                   Maximum="180"
                                   Value="25"
                                   FormatString="0"
                                   HorizontalAlignment="Right"
                                   Width="100"
                                   ValueChanged="WorkTimeInput_ValueChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Czas przerwy (min):"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   x:Name="BreakTimeInput"
                                   Minimum="1"
                                   Maximum="60"
                                   Value="5"
                                   FormatString="0"
                                   HorizontalAlignment="Right"
                                   Width="100"
                                   ValueChanged="BreakTimeInput_ValueChanged" />
                </Grid>
            </Border>

            <!-- Przyciski: Start/Pauza oraz Reset -->
            <StackPanel Orientation="Horizontal"
                        Spacing="15"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button x:Name="StartPauseButton"
                        Content="Start"
                        Width="120"
                        Height="40"
                        FontSize="16"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="StartPauseButton_Click" />

                <Button x:Name="ResetButton"
                        Content="Reset"
                        Width="120"
                        Height="40"
                        FontSize="16"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="ResetButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
